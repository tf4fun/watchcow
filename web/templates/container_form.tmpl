{{with .Container}}
<nav class="breadcrumb detail-breadcrumb" aria-label="breadcrumbs">
    <ul>
        <li><a hx-get="containers" hx-target="#main-content" hx-swap="innerHTML show:top">容器</a></li>
        <li class="is-active"><a href="#" aria-current="page">{{.Name}}</a></li>
    </ul>
</nav>

<div class="form-surface">
    <header class="detail-header">
        <div>
            <h2 class="detail-title">{{.Name}}</h2>
            <p class="detail-image" title="{{.Image}}">{{.Image}}</p>
        </div>
        <span class="status-chip {{if eq .State "running"}}is-running{{else if eq .State "exited"}}is-stopped{{end}}">
            {{if eq .State "running"}}运行中{{else if eq .State "exited"}}已停止{{else}}{{.State}}{{end}}
        </span>
    </header>

    {{if .HasLabelConfig}}
    <article class="message is-warning">
        <div class="message-body">
            <strong>标签配置容器</strong><br>
            该容器由 Docker labels 管理，请在容器配置中修改后重启。
        </div>
    </article>

    <div class="label-config-content">
        <div class="section-heading">
            <h3 class="section-title">当前标签</h3>
            <p class="section-caption">watchcow.*</p>
        </div>
        <div class="label-table">
            <table class="table is-narrow is-fullwidth">
                <tbody>
                {{range $key, $value := .Labels}}
                {{if hasPrefix $key "watchcow."}}
                <tr>
                    <td><code>{{$key}}</code></td>
                    <td>{{$value}}</td>
                </tr>
                {{end}}
                {{end}}
                </tbody>
            </table>
        </div>
    </div>

    <div class="form-actions">
        <button class="button" hx-get="containers" hx-target="#main-content" hx-swap="innerHTML show:top">
            返回列表
        </button>
    </div>
    {{else}}

    {{if $.Config.LastError}}
    <article class="message is-danger">
        <div class="message-body">{{$.Config.LastError}}</div>
    </article>
    {{else if $.Config.Deleting}}
    <article class="message is-warning">
        <div class="message-body">正在卸载应用。保存配置可取消删除并重新应用。</div>
    </article>
    {{end}}

    {{if .LegacyConfigConflict}}
    <article class="message is-warning">
        <div class="message-body">检测到多个历史配置。无法保存时，可先删除冲突配置后重新配置。</div>
    </article>
    {{end}}

    <form hx-post="containers/{{.ID}}"
          hx-target="#main-content"
          hx-swap="innerHTML show:top"
          hx-encoding="multipart/form-data">
        <div class="form-body">
            <div id="form-message"></div>

            <section class="form-section">
                <div class="section-heading">
                    <h3 class="section-title">应用设置</h3>
                    <p class="section-caption">应用元数据</p>
                </div>

                <div class="field-grid">
                    <div class="field is-full-span">
                        <label class="label">显示名称</label>
                        <div class="control">
                            <input class="input" type="text" name="display_name"
                                   value="{{$.Config.DisplayName}}"
                                   placeholder="{{.Name}}">
                        </div>
                        <p class="help">在 fnOS 中显示的名称</p>
                    </div>

                    <div class="field is-full-span">
                        <label class="label">描述</label>
                        <div class="control">
                            <textarea class="textarea" name="description"
                                      placeholder="{{.Image}}">{{$.Config.Description}}</textarea>
                        </div>
                    </div>

                    <div class="field">
                        <label class="label">版本</label>
                        <div class="control">
                            <input class="input" type="text" name="version"
                                   value="{{$.Config.Version}}"
                                   placeholder="1.0.0">
                        </div>
                    </div>

                    <div class="field">
                        <label class="label">维护者</label>
                        <div class="control">
                            <input class="input" type="text" name="maintainer"
                                   value="{{$.Config.Maintainer}}"
                                   placeholder="WatchCow">
                        </div>
                    </div>
                </div>
            </section>

            <section class="form-section">
                <div class="section-heading">
                    <h3 class="section-title">入口配置</h3>
                    <p class="section-caption">访问与跳转</p>
                </div>

                {{$entry := $.Entry}}

                <div class="field mb-4">
                    <label class="label">标题</label>
                    <div class="control">
                        <input class="input" type="text" name="entry_title"
                               value="{{$entry.Title}}"
                               placeholder="{{$.Config.DisplayName}}">
                    </div>
                    <p class="help">默认使用显示名称</p>
                </div>

                <div class="field-grid is-entry">
                    <div class="field">
                        <label class="label">协议</label>
                        <div class="control">
                            <div class="select is-fullwidth">
                                <select name="entry_protocol" required>
                                    <option value="http" {{if eq $entry.Protocol "http"}}selected{{end}}>HTTP</option>
                                    <option value="https" {{if eq $entry.Protocol "https"}}selected{{end}}>HTTPS</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="field">
                        <label class="label">端口</label>
                        <div class="control">
                            {{if .Ports}}
                            <div class="select is-fullwidth">
                                <select name="entry_port" id="entry-port" required>
                                    <option value="" {{if eq $entry.Port ""}}selected{{end}}>仅外部跳转</option>
                                    {{range $cport, $hport := .Ports}}
                                    <option value="{{$hport}}" {{if eq $entry.Port $hport}}selected{{end}}>{{$hport}}</option>
                                    {{end}}
                                </select>
                            </div>
                            {{else if eq .NetworkMode "host"}}
                            <input class="input" type="number" name="entry_port" id="entry-port"
                                   value="{{$entry.Port}}"
                                   placeholder="8080"
                                   min="1" max="65535" required>
                            {{else}}
                            <input type="hidden" name="entry_port" value="">
                            <input class="input" type="text" value="无映射端口" disabled>
                            {{end}}
                        </div>
                        {{if eq .NetworkMode "host"}}
                        <p class="help">host 网络模式，请输入容器监听的端口</p>
                        {{else if not .Ports}}
                        <p class="help">请填写外部跳转地址</p>
                        {{end}}
                    </div>

                    <div class="field">
                        <label class="label">路径</label>
                        <div class="control">
                            <input class="input" type="text" name="entry_path"
                                   value="{{$entry.Path}}"
                                   placeholder="/">
                        </div>
                    </div>
                </div>

                <div class="field-grid mt-4">
                    <div class="field">
                        <label class="label">打开方式</label>
                        <div class="control">
                            <div class="select is-fullwidth">
                                <select name="entry_ui_type" required>
                                    <option value="url" {{if eq $entry.UIType "url"}}selected{{end}}>新标签页 (url)</option>
                                    <option value="iframe" {{if eq $entry.UIType "iframe"}}selected{{end}}>桌面窗口 (iframe)</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="field">
                        <label class="label">外部跳转地址</label>
                        <div class="control">
                            <input class="input" type="text" name="entry_redirect" id="entry-redirect"
                                   value="{{$entry.Redirect}}"
                                   placeholder="https://example.com"
                                   {{if and (not .Ports) (ne .NetworkMode "host")}}required{{end}}
                                   oninput="syncPortRequirement()">
                        </div>
                        <p class="help">远程访问时使用的 HTTP(S) 地址</p>
                    </div>
                </div>

                <div class="toggle-list">
                    <label class="setting-toggle">
                        <input type="checkbox" name="entry_redirect_force_external" value="true" {{if $entry.ForceExternal}}checked{{end}}>
                        <span class="toggle-track" aria-hidden="true"></span>
                        <span class="toggle-copy"><strong>始终使用外部地址</strong></span>
                    </label>

                    <label class="setting-toggle">
                        <input type="checkbox" name="entry_all_users" value="true" {{if $entry.AllUsers}}checked{{end}}>
                        <span class="toggle-track" aria-hidden="true"></span>
                        <span class="toggle-copy"><strong>允许所有用户访问</strong></span>
                    </label>
                </div>
            </section>

            <section class="form-section">
                <div class="section-heading">
                    <h3 class="section-title">应用图标</h3>
                    <p class="section-caption">自动缩放至 256 × 256</p>
                </div>

                <div class="icon-upload-row">
                    <div class="icon-preview-frame" id="icon-preview">
                        {{if $.Config.IconBase64}}
                        <img src="data:image/png;base64,{{$.Config.IconBase64}}" alt="应用图标">
                        {{else}}
                        暂无图标
                        {{end}}
                    </div>
                    <div>
                        <div class="file">
                            <label class="file-label">
                                <input class="file-input" type="file" name="icon" accept="image/*" id="icon-input"
                                       onchange="previewIcon(this)">
                                <span class="file-cta">
                                    <span class="file-label">选择图标</span>
                                </span>
                            </label>
                        </div>
                        <p class="help">PNG、JPEG 或 WebP</p>
                    </div>
                </div>
            </section>
        </div>

        <div class="form-actions">
            <button class="button is-primary" type="submit">
                保存配置
            </button>
            {{if or .HasStoredConfig .LegacyConfigConflict}}
            <button class="button is-danger is-outlined" type="button"
                    hx-delete="containers/{{.ID}}"
                    hx-target="#main-content"
                    hx-swap="innerHTML show:top"
                    hx-include="unset"
                    hx-confirm="确定要删除此配置吗？">
                删除配置
            </button>
            {{end}}
            <button class="button" type="button"
                    hx-get="containers"
                    hx-target="#main-content"
                    hx-swap="innerHTML show:top"
                    hx-include="unset">
                返回列表
            </button>
        </div>
    </form>

    <script>
    function previewIcon(input) {
        const preview = document.getElementById('icon-preview');
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                preview.innerHTML = '<img src="' + e.target.result + '" alt="应用图标">';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function syncPortRequirement() {
        const port = document.getElementById('entry-port');
        const redirect = document.getElementById('entry-redirect');
        if (port && redirect) {
            port.required = redirect.value.trim() === '';
        }
    }

    syncPortRequirement();
    </script>
    {{end}}
</div>
{{end}}
