<div class="container-view"
     hx-get="containers"
     hx-trigger="every 3s"
     hx-target="#main-content"
     hx-swap="innerHTML">
    <header class="view-header">
        <div>
            <h2 class="view-title">容器</h2>
            <p class="view-subtitle">Docker 运行环境</p>
        </div>
        <span class="record-count">{{len .Containers}} 个容器</span>
    </header>

    <div class="data-surface">
        <table class="table is-fullwidth container-table">
            <colgroup>
                <col style="width:19%">
                <col style="width:28%">
                <col style="width:20%">
                <col style="width:15%">
                <col style="width:18%">
            </colgroup>
            <thead>
                <tr>
                    <th>容器</th>
                    <th>镜像</th>
                    <th>端口</th>
                    <th>运行状态</th>
                    <th>应用配置</th>
                </tr>
            </thead>
            <tbody>
                {{range .Containers}}
                <tr>
                    <td data-label="容器">
                        <strong class="container-primary" title="{{.Name}}">{{.Name}}</strong>
                        <span class="container-secondary" title="{{.ID}}">{{.ID}}</span>
                    </td>
                    <td data-label="镜像">
                        <span class="container-primary" title="{{.Image}}">{{.Image}}</span>
                    </td>
                    <td data-label="端口">
                        <div class="port-list">
                            {{if .Ports}}
                                {{range $cport, $hport := .Ports}}
                                <span class="port-chip">{{$cport}} → {{$hport}}</span>
                                {{end}}
                            {{else if eq .NetworkMode "host"}}
                                <span class="status-chip is-label">host 网络</span>
                            {{else}}
                                <span class="status-chip is-warning">无端口</span>
                            {{end}}
                        </div>
                    </td>
                    <td data-label="运行状态">
                        <span class="status-chip {{if eq .State "running"}}is-running{{else if eq .State "exited"}}is-stopped{{end}}">
                            {{if eq .State "running"}}运行中{{else if eq .State "exited"}}已停止{{else}}{{.State}}{{end}}
                        </span>
                    </td>
                    <td data-label="应用配置" class="application-cell">
                        {{if .HasLabelConfig}}
                            <span class="status-chip is-label" title="此容器由 Docker labels 管理">由标签配置</span>
                        {{else if .LegacyConfigConflict}}
                            <button class="button is-small is-state-danger configure-button"
                                    hx-get="containers/{{.ID}}"
                                    hx-target="#main-content"
                                    hx-swap="innerHTML show:top"
                                    title="检测到旧配置冲突，点击处理">
                                处理冲突
                            </button>
                        {{else if .HasStoredConfig}}
                            <button class="button is-small configure-button
                                    {{if .Config.Deleting}}{{if .Config.LastError}}is-state-danger{{else}}is-state-pending{{end}}
                                    {{else if .Config.Pending}}{{if .Config.LastError}}is-state-danger{{else}}is-state-pending{{end}}
                                    {{else if .Config.LastError}}is-state-danger
                                    {{else}}is-primary is-outlined{{end}}"
                                    hx-get="containers/{{.ID}}"
                                    hx-target="#main-content"
                                    hx-swap="innerHTML show:top"
                                    title="点击查看配置">
                                {{if .Config.Deleting}}
                                    {{if .Config.LastError}}删除失败{{else}}删除中{{end}}
                                {{else if .Config.Pending}}
                                    {{if .Config.LastError}}应用失败{{else if eq .State "running"}}应用中{{else}}等待运行{{end}}
                                {{else if .Config.LastError}}
                                    待修复
                                {{else}}
                                    修改配置
                                {{end}}
                            </button>
                            {{if .Config.LastError}}
                            <p class="status-detail" title="{{.Config.LastError}}">{{.Config.LastError}}</p>
                            {{end}}
                        {{else}}
                            <button class="button is-small is-primary configure-button add-config-button"
                                    hx-get="containers/{{.ID}}"
                                    hx-target="#main-content"
                                    hx-swap="innerHTML show:top">
                                添加配置
                            </button>
                        {{end}}
                    </td>
                </tr>
                {{else}}
                <tr>
                    <td colspan="5" class="empty-state">
                        <strong>未找到容器</strong>
                        <span>Docker 中暂无可显示的容器</span>
                    </td>
                </tr>
                {{end}}
            </tbody>
        </table>
    </div>
</div>
